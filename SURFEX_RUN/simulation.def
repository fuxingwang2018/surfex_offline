FORCPREFIX='GreenWave_FORCING_mlL65_SCA_VARY'


# Definations for PGD, should be consistent with OPTIONS.nam
# Copied from HCLIM sms/config_exp.h
SOIL_TEXTURE_VERSION=FAO
ECOCLIMAP_VERSION=2.2
# Additional urban physiography specifications for surfex (none|urban)
# none for default physiography | urban for new physiography 
SURFEX_URBAN_SPEC=none
# copied from config-sh/config.bi in HCLIM (PGD_DATA_PATH & ECOCLIMAP_DATA_PATH)
#PGD_DATA_PATH='/nobackup/smhid13/sm_esbol/harmonie_climate/40h1.1_test/PGD'

LAST_YEAR=2018
FIRST_MONTH=8
LAST_MONTH=10
FIRST_DAY=01
#LAST_DAY=31
FIRST_HOUR=00
LAST_HOUR=24

# Define the path to models
# change ${HOME} to /home/sm_fuxwa if you use Fuxing compiled code.
MODEL=${HOME}/SURFEX_HCLIM_cy38h12_with_ISBAv8_mums/src/dir_obj-LXifort-SFX-V7-3-0-MPIAUTO-O2/${VER_USER_NAME}/OFFLINE

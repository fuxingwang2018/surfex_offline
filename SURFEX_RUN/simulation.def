#VER_USER_NAME=MASTER
# Usually no need to change VER_MPI_NAME
VER_MPI_NAME=MPIAUTO

# Period to be covered by simulation
# Change FIRST_YEAR, LAST_YEAR, FIRST_MONTH, LAST_MONTH
